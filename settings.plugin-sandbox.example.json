{
  "schemaVersion": 1,
  "pluginSandbox": {
    "defaults": {
      "timeoutMs": 1000,
      "memoryMiB": 16,
      "hookAction": "deny",
      "violationAction": "deny"
    },
    "plugins": [
      {
        "id": "echo",
        "enabled": true,
        "match": "#echo*",
        "capabilities": ["reply", "writeText"],
        "hookAction": "audit",
        "rules": []
      }
    ]
  }
}
