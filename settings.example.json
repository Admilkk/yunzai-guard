{
  "schemaVersion": 1,
  "isolationMode": "managed",
  "sandbox": {
    "network": "none",
    "writablePaths": ["data", "temp", "logs", "config/config"]
  },
  "startupTimeout": 60000,
  "shutdownTimeout": 10000,
  "handshakeTimeout": 5000,
  "recovery": {
    "maxRestarts": 3,
    "windowMs": 60000,
    "baseDelayMs": 250,
    "maxDelayMs": 30000
  },
  "audit": {
    "maxEventsPerSecond": 1000,
    "maxQueue": 5000,
    "maxBytes": 10485760,
    "maxFiles": 3,
    "maxDays": 0,
    "coalesceMs": 1000,
    "durability": "adaptive"
  },
  "log": {
    "maxBytes": 4194304,
    "maxDays": 0
  },
  "update": {
    "check": true,
    "notify": true,
    "intervalMs": 300000
  },
  "protect": {
    "enabled": true,
    "intervalMs": 1000,
    "action": "audit",
    "targets": [
      "Bot.sendFriendMsg",
      "Bot.sendGroupMsg",
      "Bot.sendMasterMsg",
      "Bot.sendForwardMsg",
      "Bot.fileToUrl",
      "Bot.serverAuth",
      "Bot.exitEvent",
      "PluginsLoader.load",
      "PluginsLoader.importPlugin",
      "PluginsLoader.loadPlugin",
      "PluginsLoader.unloadPlugin",
      "PluginsLoader.changePlugin",
      "PluginsLoader.registerHandlers",
      "PluginsLoader.dealEvent",
      "PluginsLoader.filtPermission",
      "PluginsLoader.checkBlack",
      "PluginsLoader.checkDisable",
      "PluginsLoader.checkLimit",
      "PluginsLoader.collectTask",
      "PluginsLoader.startTask",
      "Global.plugin.prototype.reply",
      "Global.plugin.prototype.renderImg"
    ],
    "monitorInstrumentation": true
  },
  "rules": [],
  "pluginSandbox": {
    "plugins": []
  },
  "alerts": {
    "enabled": true,
    "masters": true,
    "webhook": {
      "url": "",
      "secret": "",
      "format": "json"
    },
    "on": {
      "deny": true,
      "restart": true,
      "tripped": true,
      "integrity": true,
      "anomaly": true,
      "source": true,
      "update": true
    },
    "forward": {
      "actions": ["deny", "restart"],
      "kinds": []
    },
    "throttle": {
      "windowMs": 60000,
      "maxPerWindow": 5
    }
  },
  "baseline": {
    "enabled": false,
    "learnHours": 72,
    "kinds": ["network", "listen", "process", "native"],
    "ignore": [],
    "ignorePlugins": [],
    "learnAfterAlert": true,
    "maxPerPlugin": 500,
    "minSeverity": "medium",
    "spike": {
      "enabled": true,
      "zScore": 4,
      "minCount": 30,
      "windowMs": 600000
    },
    "offHours": true,
    "burst": {
      "enabled": true,
      "count": 8,
      "windowMs": 600000
    }
  },
  "sources": {
    "enabled": true,
    "intervalMs": 600000,
    "ignore": [],
    "notify": {
      "commit": false,
      "dirty": true,
      "remote": true
    }
  }
}
