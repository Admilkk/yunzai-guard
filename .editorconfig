root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# 固定分发包和测试输入保留原始字节。
[{native/process-identity,native/bubblewrap,dist,tests/fixtures}/**]
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

[*.patch]
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
